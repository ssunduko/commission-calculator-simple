%%{init: {'theme':'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryTextColor': '#000000', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'secondaryColor': '#ffffff', 'tertiaryColor': '#ffffff', 'background': '#ffffff', 'mainBkg': '#ffffff', 'secondBkg': '#ffffff', 'tertiaryBkg': '#ffffff'}}}%%
classDiagram
    %% Abstract class and interface
    class BaseEntity {
        <<abstract>>
        #String id
        #LocalDateTime createdDate
        #LocalDateTime lastModifiedDate
        +getId() String
        +updateTimestamp() void
    }
    
    class Calculable {
        <<interface>>
        +calculate() BigDecimal
        +validate() boolean
    }
    
    %% Core domain classes
    class User {
        -String id
        -String username
        -String email
        -UserRole role
        +authenticate() boolean
        +getPermissions() List~Permission~
    }
    
    class Deal {
        -String id
        -BigDecimal amount
        -LocalDateTime closeDate
        -DealStatus status
        +calculateCommission() BigDecimal
        +validate() boolean
    }
    
    class Commission {
        -String id
        -BigDecimal amount
        -CommissionStatus status
        -LocalDateTime calculationDate
        +calculate() BigDecimal
        +approve() void
    }
    
    class CommissionPlan {
        -String id
        -String name
        -boolean isActive
        +getTiers() List~CommissionTier~
        +calculateCommission(Deal) BigDecimal
    }
    
    class CommissionRule {
        -String id
        -String ruleType
        -BigDecimal threshold
        +apply(Deal) BigDecimal
        +validate() boolean
    }
    
    class CommissionTier {
        -String id
        -BigDecimal minAmount
        -BigDecimal maxAmount
        -BigDecimal rate
        +calculateTierCommission(BigDecimal) BigDecimal
    }
    
    class Dispute {
        -String id
        -String title
        -String description
        -DisputeStatus status
        -LocalDateTime createdDate
        +escalate() void
        +resolve() void
    }
    
    class DisputeComment {
        -String id
        -String comment
        -LocalDateTime createdDate
        +addComment() void
    }
    
    class AuditEntry {
        -String id
        -String action
        -LocalDateTime timestamp
        -String details
        +log() void
    }
    
    class DealProduct {
        -String productId
        -int quantity
        -BigDecimal unitPrice
        +getTotalValue() BigDecimal
    }
    
    %% Inheritance relationships
    BaseEntity <|-- User
    BaseEntity <|-- Deal
    BaseEntity <|-- Commission
    
    %% Interface implementations
    Calculable <|.. Commission
    Calculable <|.. CommissionPlan
    
    %% Composition relationships
    CommissionPlan *-- CommissionTier
    Dispute *-- DisputeComment
    
    %% Aggregation relationships
    CommissionPlan o-- CommissionRule
    User o-- CommissionPlan
    
    %% Association relationships
    User "1" --> "*" Deal
    Deal "1" --> "1" Commission
    User "1" --> "*" Commission
    Deal "1" --> "*" DealProduct
    
    %% Simple association
    Dispute -- Commission
    
    %% Dependency relationships
    Commission ..> AuditEntry
    Deal ..> CommissionRule
    CommissionPlan ..> Deal