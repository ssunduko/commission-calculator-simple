' Title
title Singleton Pattern - Commission Calculator Implementations

' Basic Singleton
class BasicSingleton <<Singleton>> {
  {static} -instance: BasicSingleton
  -commissionCalculation: CommissionCalculation
  -BasicSingleton()
  {static} +getInstance(): BasicSingleton
  +getCommissionCalculation(): CommissionCalculation
  +calculateCommission(dealId, salesRepId, amount): CommissionCalculation
}

' Thread-Safe Singleton - Synchronized Method
class ThreadSafeSingletonSynchronizedMethod <<Singleton>> {
  {static} -instance: ThreadSafeSingletonSynchronizedMethod
  -commissionCalculation: CommissionCalculation
  -ThreadSafeSingletonSynchronizedMethod()
  {static} +«synchronized» getInstance(): ThreadSafeSingletonSynchronizedMethod
  +getCommissionCalculation(): CommissionCalculation
  +calculateCommission(dealId, salesRepId, amount): CommissionCalculation
}

' Thread-Safe Singleton - Double-Checked Locking
class ThreadSafeSingletonDoubleCheckedLocking <<Singleton>> {
  {static} -«volatile» instance: ThreadSafeSingletonDoubleCheckedLocking
  -commissionCalculation: CommissionCalculation
  -ThreadSafeSingletonDoubleCheckedLocking()
  {static} +getInstance(): ThreadSafeSingletonDoubleCheckedLocking
  +getCommissionCalculation(): CommissionCalculation
  +calculateCommission(dealId, salesRepId, amount): CommissionCalculation
}

' Thread-Safe Singleton - Eager Initialization
class ThreadSafeSingletonEagerInitialization <<Singleton>> {
  {static} -instance: ThreadSafeSingletonEagerInitialization = new ...
  -commissionCalculation: CommissionCalculation
  -ThreadSafeSingletonEagerInitialization()
  {static} +getInstance(): ThreadSafeSingletonEagerInitialization
  +getCommissionCalculation(): CommissionCalculation
  +calculateCommission(dealId, salesRepId, amount): CommissionCalculation
}

' Thread-Safe Singleton - Initialization-on-Demand
class ThreadSafeSingletonInitializationOnDemand <<Singleton>> {
  -commissionCalculation: CommissionCalculation
  -ThreadSafeSingletonInitializationOnDemand()
  {static} +getInstance(): ThreadSafeSingletonInitializationOnDemand
  +getCommissionCalculation(): CommissionCalculation
  +calculateCommission(dealId, salesRepId, amount): CommissionCalculation
}

class Holder <<StaticHolder>> {
  {static} +INSTANCE: ThreadSafeSingletonInitializationOnDemand
}

' Enum Singleton
enum EnumSingleton <<Singleton>> {
  INSTANCE
  -commissionCalculation: CommissionCalculation
  +getCommissionCalculation(): CommissionCalculation
  +calculateCommission(dealId, salesRepId, amount): CommissionCalculation
}

' Domain Model
class CommissionCalculation <<DomainModel>> {
  -id: String
  -calculatedBy: String
  -dealId: String
  -salesRepId: String
  -baseCommission: BigDecimal
  +recalculate(): void
}

