' Title
title Iterator Pattern - Commission Data Traversal

' Iterator Interface
interface CommissionIterator<T> <<Iterator>> {
  +hasNext(): boolean
  +next(): T
  +remaining(): int
  +reset(): void
}

' Concrete Iterators for Deals
class AllDealsIterator <<ConcreteIterator>> {
  -currentIndex: int
  +hasNext(): boolean
  +next(): Deal
  +remaining(): int
  +reset(): void
}

class StatusFilterIterator <<ConcreteIterator>> {
  -targetStatus: DealStatus
  -currentIndex: int
  -nextDeal: Deal
  -nextSet: boolean
  +hasNext(): boolean
  +next(): Deal
  +remaining(): int
  +reset(): void
  -findNext(): Deal
}

class ValueRangeIterator <<ConcreteIterator>> {
  -minValue: BigDecimal
  -maxValue: BigDecimal
  -currentIndex: int
  -nextDeal: Deal
  -nextSet: boolean
  +hasNext(): boolean
  +next(): Deal
  +remaining(): int
  +reset(): void
  -findNext(): Deal
}

class DateFilterIterator <<ConcreteIterator>> {
  -afterDate: LocalDate
  -currentIndex: int
  -nextDeal: Deal
  -nextSet: boolean
  +hasNext(): boolean
  +next(): Deal
  +remaining(): int
  +reset(): void
  -findNext(): Deal
}

class ValueSortedIterator <<ConcreteIterator>> {
  -sortedDeals: List<Deal>
  -currentIndex: int
  +hasNext(): boolean
  +next(): Deal
  +remaining(): int
  +reset(): void
}

' Aggregate for Deals
class DealCollection <<Aggregate>> {
  -deals: List<Deal>
  +addDeal(deal: Deal): void
  +size(): int
  +createIterator(): CommissionIterator<Deal>
  +createStatusIterator(status: DealStatus): CommissionIterator<Deal>
  +createValueRangeIterator(min: BigDecimal, max: BigDecimal): CommissionIterator<Deal>
  +createDateIterator(afterDate: LocalDate): CommissionIterator<Deal>
  +createValueSortedIterator(): CommissionIterator<Deal>
}

' Concrete Iterators for Plans
class ActivePlansIterator <<ConcreteIterator>> {
  -currentIndex: int
  -nextPlan: CommissionPlan
  -nextSet: boolean
  +hasNext(): boolean
  +next(): CommissionPlan
  +remaining(): int
  +reset(): void
  -findNext(): CommissionPlan
}

class EffectiveDateIterator <<ConcreteIterator>> {
  -targetDate: LocalDate
  -currentIndex: int
  -nextPlan: CommissionPlan
  -nextSet: boolean
  +hasNext(): boolean
  +next(): CommissionPlan
  +remaining(): int
  +reset(): void
  -findNext(): CommissionPlan
}

' Aggregate for Plans
class CommissionPlanRepository <<Aggregate>> {
  -plans: List<CommissionPlan>
  +addPlan(plan: CommissionPlan): void
  +size(): int
  +createActiveIterator(): CommissionIterator<CommissionPlan>
  +createEffectiveOnIterator(date: LocalDate): CommissionIterator<CommissionPlan>
}

' Composite Iterator
class CompositeIterator<T> <<CompositeIterator>> {
  -iterators: List<CommissionIterator<T>>
  -currentIteratorIndex: int
  +hasNext(): boolean
  +next(): T
  +remaining(): int
  +reset(): void
}

' Domain Models
class Deal <<DomainModel>> {
  -id: String
  -title: String
  -value: BigDecimal
  -status: DealStatus
  -salesRepId: String
  -closeDate: LocalDate
}

class CommissionPlan <<DomainModel>> {
  -id: String
  -planName: String
  -status: PlanStatus
  -effectiveDate: LocalDate
  -expiryDate: LocalDate
  +isActiveOn(date: LocalDate): boolean
}

enum DealStatus <<Enumeration>> {
  OPEN
  WON
  LOST
  CANCELLED
}

enum PlanStatus <<Enumeration>> {
  DRAFT
  ACTIVE
  ARCHIVED
}

