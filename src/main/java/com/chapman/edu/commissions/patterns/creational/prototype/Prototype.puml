@startuml Prototype Pattern

left to right direction
title "Prototype Pattern - Commission System"

package "Prototype Pattern" {
  ' Prototype Interface
  interface Prototype {
    + clone(): Prototype
  }

  ' Concrete Prototypes
  class Deal {
    - id: String
    - title: String
    - value: BigDecimal
    - status: DealStatus
    - salesRepId: String
    - products: List<DealProduct>
    - closeDate: LocalDate
    - createdDate: LocalDate
    - lastModifiedDate: LocalDate
    + Deal()
    + Deal(title: String, value: BigDecimal, salesRepId: String)
    + clone(): Deal
    + deepClone(): Deal
  }

  class DealProduct {
    - id: String
    - productId: String
    - productName: String
    - quantity: int
    - price: BigDecimal
    - discount: BigDecimal
    - dealId: String
    + DealProduct()
    + DealProduct(productId: String, productName: String, quantity: int, price: BigDecimal)
    + clone(): DealProduct
  }

  ' Prototype Registry
  class DealPrototypeRegistry {
    - prototypes: Map<String, Deal>
    + DealPrototypeRegistry()
    + addPrototype(key: String, prototype: Deal): void
    + getPrototype(key: String): Deal
    + removePrototype(key: String): void
  }

  ' Client
  class Client {
    + createDealFromPrototype(): Deal
    + createCustomizedDeal(): Deal
  }

  ' Relationships
  Prototype <|.. Deal : implements
  Prototype <|.. DealProduct : implements
  Deal *-- DealProduct : contains
  DealPrototypeRegistry o-- Deal : manages
  Client ..> Deal : uses
  Client ..> DealPrototypeRegistry : uses
}

@enduml