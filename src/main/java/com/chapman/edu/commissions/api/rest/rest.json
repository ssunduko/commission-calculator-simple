								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": \"{{dealId}}\",\n    \"title\": \"Enterprise Software License - Updated\",\n    \"value\": 550000.00,\n    \"salesRepId\": \"USER-001\",\n    \"status\": \"WON\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/deals/{{dealId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"deals",
								"{{dealId}}"
							]
						},
						"description": "Update an existing deal.\n\nRequires full deal object with ID matching path parameter.\nReturns 404 if deal not found."
					},
					"response": []
				},
				{
					"name": "Delete Deal",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 204\", function () {",
									"    pm.response.to.have.status(204);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/deals/{{dealId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"deals",
								"{{dealId}}"
							]
						},
						"description": "Delete a deal by ID.\n\nReturns 204 No Content on success.\nReturns 404 if deal not found."
					},
					"response": []
				},
				{
					"name": "Filter Deals by Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"All deals have WON status\", function () {",
									"    var jsonData = pm.response.json();",
									"    jsonData.forEach(function(deal) {",
									"        pm.expect(deal.status).to.eql('WON');",
									"    });",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/deals?status=WON",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"deals"
							],
							"query": [
								{
									"key": "status",
									"value": "WON"
								}
							]
						},
						"description": "Filter deals by status.\n\nValid status values:\n- OPEN\n- WON\n- LOST\n- CANCELLED"
					},
					"response": []
				},
				{
					"name": "Filter Deals by Sales Rep",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/deals?salesRepId=USER-001",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"deals"
							],
							"query": [
								{
									"key": "salesRepId",
									"value": "USER-001"
								}
							]
						},
						"description": "Filter deals by sales representative ID."
					},
					"response": []
				}
			],
			"description": "Deal management endpoints.\n\nDeals represent sales opportunities with associated products and values."
