' Service Implementations
class DealServiceImpl <<ServiceImplementation>> {
    - dealRepository: Repository<Deal>
    + createDeal(request, responseObserver)
    + getDeal(request, responseObserver)
    + listDeals(request, responseObserver)
    + updateDeal(request, responseObserver)
    + deleteDeal(request, responseObserver)
}

class UserServiceImpl <<ServiceImplementation>> {
    - userRepository: Repository<User>
    + createUser(request, responseObserver)
    + getUser(request, responseObserver)
    + listUsers(request, responseObserver)
    + updateUser(request, responseObserver)
    + deleteUser(request, responseObserver)
}

' Model Converter
class ModelConverter <<Utility>> {
    {static} + toProtoDeal(Deal): Deal
    {static} + fromProtoDeal(Deal): Deal
    {static} + toProtoUser(User): User
    {static} + fromProtoUser(User): User
    {static} + toProtoDecimal(BigDecimal): Decimal
    {static} + fromProtoDecimal(Decimal): BigDecimal
    {static} + toProtoDate(LocalDate): Date
    {static} + fromProtoDate(Date): LocalDate
}

' Repository Interface
interface Repository <<Interface>> {
    + save(T): T
    + findById(String): Optional<T>
    + findAll(): List<T>
    + deleteById(String): boolean
}

' In-Memory Repository
class InMemoryRepository <<Repository>> {
    - storage: Map<String, T>
    - idPrefix: String
    - idCounter: AtomicInteger
    + save(T): T
    + findById(String): Optional<T>
    + findAll(): List<T>
    + deleteById(String): boolean
}

' gRPC Server
class GrpcServer <<EmbeddedServer>> {
    - server: Server
    - dealRepository: Repository<Deal>
    - userRepository: Repository<User>
    - planRepository: Repository<CommissionPlan>
    - disputeRepository: Repository<Dispute>
    + start(): void
    + stop(): void
    + getDealRepository(): Repository<Deal>
    + getUserRepository(): Repository<User>
    {static} + main(String[]): void
}

' Domain Models
class Deal <<DomainModel>> {
    - id: String
    - title: String
    - value: BigDecimal
    - status: DealStatus
    - salesRepId: String
    - products: List<DealProduct>
    - closeDate: LocalDate
}

class User <<DomainModel>> {
    - id: String
    - username: String
    - email: String
    - firstName: String
    - lastName: String
    - roles: Set<UserRole>
    - active: boolean
}

' Relationships

' Proto to Generated Classes
DealService_proto .down.> DealServiceGrpc : << generates >>
DealService_proto .down.> DealServiceImplBase : << generates >>
UserService_proto .down.> UserServiceGrpc : << generates >>
UserService_proto .down.> UserServiceImplBase : << generates >>

' Generated Base Class to Implementation
DealServiceImplBase <|-- DealServiceImpl : extends
UserServiceImplBase <|-- UserServiceImpl : extends

' Service Implementation to Repository
DealServiceImpl o-right-> Repository : uses
UserServiceImpl o-right-> Repository : uses

' Repository Implementation
Repository <|.down. InMemoryRepository : implements

' Service Implementation to Model Converter
DealServiceImpl ..> ModelConverter : uses
UserServiceImpl ..> ModelConverter : uses

' Model Converter to Domain Models
ModelConverter ..> Deal : converts
ModelConverter ..> User : converts

' Server to Service Implementations
GrpcServer o-down-> DealServiceImpl : registers
GrpcServer o-down-> UserServiceImpl : registers

' Server to Repositories
GrpcServer o-right-> Repository : provides

' Component Notes
note right of DealService_proto
  <b>Protocol Buffer Definition</b>
  .proto file defining the service
  contract: messages, RPCs, and types.

  - Language-neutral interface
  - Compiled by protoc
  - Generates client & server code
  - Version control friendly
end note

note bottom of DealServiceGrpc
  <b>Generated Client Stubs</b>
  Auto-generated by protoc compiler.
  Provides three stub types:

  • <b>Stub:</b> Async/callback-based
  • <b>BlockingStub:</b> Synchronous
  • <b>FutureStub:</b> Future-based async
end note

note bottom of DealServiceImplBase
  <b>Generated Service Base</b>
  Abstract base class with default
  implementations (return UNIMPLEMENTED).

  Service implementations extend this
  and override RPC methods.
end note

note left of DealServiceImpl
  <b>Service Implementation</b>
  Concrete implementation of gRPC service.

  <b>Responsibilities:</b>
  • Handle RPC requests
  • Validate input
  • Convert proto ↔ domain models
  • Delegate to repository
  • Handle errors (gRPC Status)
  • Send responses via StreamObserver

  <b>Pattern:</b> Uses Repository for data
  access and ModelConverter for
  type adaptation.
end note

note bottom of ModelConverter
  <b>Adapter Pattern</b>
  Converts between two incompatible
  interfaces:
  • Domain models (business layer)
  • Proto messages (transport layer)

  <b>Benefits:</b>
  • Separation of concerns
  • Independent evolution
  • Type safety
  • Centralized conversion logic
end note

note right of Repository
  <b>Repository Pattern</b>
  Abstraction for data access.

  <b>Benefits:</b>
  • Decouples business logic from storage
  • Easy to swap implementations
  • Testability (mock repositories)
  • Single Responsibility Principle
end note

note bottom of GrpcServer
  <b>Embedded gRPC Server</b>
  Similar to embedded Tomcat in REST API,
  but uses gRPC's Netty-based server.

  <b>Features:</b>
  • HTTP/2 transport
  • Service registration
  • Port binding (50051 default)
  • Graceful shutdown
  • Dependency injection

  <b>Lifecycle:</b>
  build() → start() → awaitTermination()
          → shutdown() → awaitTermination()
end note

note right of Deal
  <b>Domain Model</b>
  Business entities independent
  of transport mechanism.

  Can be used by:
  • REST API (JSON)
  • gRPC API (protobuf)
  • SOAP API (XML)
  • GraphQL API
end note

' Legend
legend right
  <b>gRPC Architecture Components:</b>

  <b>1. Protocol Buffers (.proto files):</b>
  Define the API contract with messages
  and service RPCs.

  <b>2. Code Generation (protoc):</b>
  Compiler generates:
  • Message classes (immutable, builders)
  • Service stubs (client)
  • Service base classes (server)

  <b>3. Service Implementation:</b>
  Extends generated base class and
  implements business logic.

  <b>4. Model Converter (Adapter):</b>
  Translates between domain models
  and proto messages.

  <b>5. Repository Pattern:</b>
  Abstracts data storage from
  business logic.

  <b>6. gRPC Server:</b>
  Embedded server that registers
  services and handles HTTP/2.

  <b>Key Benefits of gRPC:</b>
  ✓ Type-safe contracts (.proto)
  ✓ Automatic code generation
  ✓ Efficient binary serialization
  ✓ HTTP/2 features (multiplexing, streaming)
  ✓ Multi-language support
  ✓ Built-in streaming support

  <b>gRPC vs REST:</b>
  • gRPC: Binary (protobuf), HTTP/2
  • REST: Text (JSON), HTTP/1.1

  <b>Communication Flow:</b>
  Client → gRPC Stub → Network (HTTP/2) →
  gRPC Server → Service Impl → Repository →
  Domain Model → (reverse path for response)
endlegend

@enduml