' Title
title Rate Limiting Performance Architecture - Commission Calculator

' Rate Limiter Interface
interface RateLimiter <<Strategy>> {
  +tryAcquire(key: String): boolean
  +tryAcquire(key: String, timeout: Duration): boolean
  +getAvailablePermits(key: String): long
  +getTimeUntilNextPermit(key: String): Duration
  +reset(key: String): void
  +resetAll(): void
}

' Token Bucket Rate Limiter
class TokenBucketRateLimiter <<ConcreteStrategy>> {
  -config: RateLimitConfig
  -buckets: Map<String, TokenBucket>
  +TokenBucketRateLimiter(config: RateLimitConfig)
  +tryAcquire(key: String): boolean
  +tryAcquire(key: String, timeout: Duration): boolean
  +getAvailablePermits(key: String): long
  +getTimeUntilNextPermit(key: String): Duration
  +reset(key: String): void
  +resetAll(): void
}

' Token Bucket Inner Class
class TokenBucket <<InnerClass>> {
  -capacity: long
  -refillRate: double
  -tokens: double
  -lastRefill: Instant
  -lock: Lock
  +TokenBucket(config: RateLimitConfig)
  +tryConsume(): boolean
  +getAvailableTokens(): long
  +getTimeUntilNextToken(): Duration
  -refill(): void
}

' Sliding Window Rate Limiter
class SlidingWindowRateLimiter <<ConcreteStrategy>> {
  -config: RateLimitConfig
  -windows: Map<String, RequestWindow>
  +SlidingWindowRateLimiter(config: RateLimitConfig)
  +tryAcquire(key: String): boolean
  +tryAcquire(key: String, timeout: Duration): boolean
  +getAvailablePermits(key: String): long
  +getTimeUntilNextPermit(key: String): Duration
  +reset(key: String): void
  +resetAll(): void
}

' Request Window Inner Class
class RequestWindow <<InnerClass>> {
  -limit: long
  -windowDuration: Duration
  -requestTimestamps: Queue<Instant>
  -lock: Lock
  +RequestWindow(config: RateLimitConfig)
  +tryAddRequest(): boolean
  +getAvailableRequests(): long
  +getTimeUntilNextSlot(): Duration
  -removeExpiredRequests(): void
}

' Rate Limit Config
class RateLimitConfig <<ValueObject>> {
  -requestsPerWindow: long
  -windowDuration: Duration
  -blockOnExceeded: boolean
  -maxWaitTime: Duration
  +defaultConfig(): RateLimitConfig
  +strictConfig(): RateLimitConfig
  +permissiveConfig(): RateLimitConfig
  +builder(): Builder
  +getRequestsPerWindow(): long
  +getWindowDuration(): Duration
  +isBlockOnExceeded(): boolean
  +getMaxWaitTime(): Duration
  +getRequestsPerSecond(): double
}

' Config Builder
class Builder <<Builder>> {
  -requestsPerWindow: long
  -windowDuration: Duration
  -blockOnExceeded: boolean
  -maxWaitTime: Duration
  +requestsPerWindow(long): Builder
  +windowDuration(Duration): Builder
  +blockOnExceeded(boolean): Builder
  +maxWaitTime(Duration): Builder
  +build(): RateLimitConfig
}

' Rate Limit Filter
class RateLimitFilter <<Filter>> {
  -rateLimiter: RateLimiter
  -keyExtractor: Function<HttpServletRequest, String>
  -config: RateLimitConfig
  +RateLimitFilter(rateLimiter: RateLimiter, keyExtractor: Function, config: RateLimitConfig)
  +createIpBasedFilter(config: RateLimitConfig): RateLimitFilter
  +createUserBasedFilter(config: RateLimitConfig): RateLimitFilter
  +createApiKeyBasedFilter(config: RateLimitConfig): RateLimitFilter
  +init(filterConfig: FilterConfig): void
  +doFilter(request: ServletRequest, response: ServletResponse, chain: FilterChain): void
  +destroy(): void
  -setRateLimitHeaders(response: HttpServletResponse, key: String): void
  -handleRateLimitExceeded(response: HttpServletResponse, key: String): void
  -extractIpAddress(request: HttpServletRequest): String
  -extractUserId(request: HttpServletRequest): String
  -extractApiKey(request: HttpServletRequest): String
}

' Rate Limit Exception
class RateLimitExceededException <<Exception>> {
  -key: String
  -limit: long
  -retryAfter: Duration
  +RateLimitExceededException(key: String, limit: long, retryAfter: Duration)
  +getKey(): String
  +getLimit(): long
  +getRetryAfter(): Duration
  +getRetryAfterSeconds(): long
}

' Error Response Inner Class
class RateLimitErrorResponse <<InnerClass>> {
  -status: int
  -message: String
  -limit: long
  -retryAfter: long
  -timestamp: long
  +RateLimitErrorResponse(status: int, message: String, limit: long, retryAfter: long)
  +getStatus(): int
  +getMessage(): String
  +getLimit(): long
  +getRetryAfter(): long
  +getTimestamp(): long
}

