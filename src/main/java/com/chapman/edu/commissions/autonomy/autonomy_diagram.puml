' Classes
class DataAutonomyExample {
  -dealStore: Map<String, Deal>
  -userStore: Map<String, User>
  +createDeal(title: String, value: BigDecimal, salesRepId: String): String
  +addProductToDeal(dealId: String, productName: String, quantity: int, price: BigDecimal): String
  +updateDealStatus(dealId: String, status: DealStatus): void
  +createUser(username: String, email: String, firstName: String, lastName: String, role: UserRole): String
  +getDealById(dealId: String): Deal
  +getUserById(userId: String): User
  +getDealsBySalesRep(salesRepId: String): List<Deal>
  +getUsersByRole(role: UserRole): List<User>
  -initializeSampleData(): void
}

class FunctionalAutonomyExample {
  -dealStore: Map<String, Deal>
  -userStore: Map<String, User>
  -planStore: Map<String, CommissionPlan>
  -calculationStore: Map<String, CommissionCalculation>
  +createCommissionPlan(name: String, description: String, effectiveDate: LocalDate): String
  +addRuleToPlan(planId: String, name: String, description: String): String
  +addTierToRule(planId: String, ruleId: String, minAmount: BigDecimal, maxAmount: BigDecimal, rate: BigDecimal): void
  +createDeal(title: String, value: BigDecimal, salesRepId: String): String
  +addProductToDeal(dealId: String, productName: String, quantity: int, price: BigDecimal): String
  +updateDealStatus(dealId: String, status: DealStatus): void
  +createUser(username: String, email: String, firstName: String, lastName: String, role: UserRole): String
  +assignPlanToUser(userId: String, planId: String): void
  +calculateCommission(dealId: String): String
  -calculateCommissionAmount(deal: Deal, plan: CommissionPlan): BigDecimal
  +getCalculationsBySalesRep(salesRepId: String): List<CommissionCalculation>
  +getTotalCommissionForSalesRep(salesRepId: String): BigDecimal
  -initializeSampleData(): void
}

