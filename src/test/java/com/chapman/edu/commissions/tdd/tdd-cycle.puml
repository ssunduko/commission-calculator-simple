' Title
title Test-Driven Development (TDD) - RED-GREEN-REFACTOR Cycle

' Test Class
class TDDTest <<TestClass>> {
  -commissionService: TDD
  -testDeal: Deal
  -testPlan: CommissionPlan
  +setUp(): void
  +testBasicCommissionCalculation_RedPhase(): void
  +testDealValidation_RedPhase(): void
  +testTieredCommissionCalculation_RedPhase(): void
  +testCommissionWithBonus_RedPhase(): void
  +testFullCommissionPipeline_RedPhase(): void
  +testEdgeCasesAndValidation_RedPhase(): void
  +testCommissionHistoryTracking_RedPhase(): void
  +testRefactoredMethodsMaintainCorrectness(): void
  +testFirstPrinciples(): void
  +tearDown(): void
}

' Implementation Class
class TDD <<Implementation>> {
  -calculationCount: int
  +calculateBasicCommission(dealValue: BigDecimal, rate: BigDecimal): BigDecimal
  +isDealEligibleForCommission(deal: Deal): boolean
  +calculateTieredCommission(dealValue: BigDecimal): BigDecimal
  +calculateCommissionWithBonus(baseCommission: BigDecimal, bonusPercentage: BigDecimal): BigDecimal
  +calculateFullCommission(deal: Deal, bonusRate: BigDecimal): BigDecimal
  +getCalculationCount(): int
  +resetCalculationCount(): int
  +getServiceSummary(): String
  -incrementCalculationCount(): void
}

' Domain Models
class Deal <<DomainModel>> {
  -id: String
  -title: String
  -value: BigDecimal
  -status: DealStatus
  -salesRepId: String
  -closeDate: LocalDate
  +getValue(): BigDecimal
  +getStatus(): DealStatus
}

class CommissionPlan <<DomainModel>> {
  -id: String
  -name: String
  -status: PlanStatus
  -effectiveStartDate: LocalDate
  -effectiveEndDate: LocalDate
}

enum DealStatus <<Enum>> {
  OPEN
  CLOSED
  LOST
  PENDING
}

enum PlanStatus <<Enum>> {
  DRAFT
  ACTIVE
  ARCHIVED
}

' TDD Cycle Representation
class "RED Phase" as RED <<TDDPhase>> {
  **Write Failing Test**
  --
  • Write test first
  • Test must fail
  • Defines requirement
  • Proves test works
}

class "GREEN Phase" as GREEN <<TDDPhase>> {
  **Make Test Pass**
  --
  • Write minimal code
  • Make test green
  • Don't over-engineer
  • Keep it simple
}

class "REFACTOR Phase" as REFACTOR <<TDDPhase>> {
  **Improve Code Quality**
  --
  • Clean up code
  • Remove duplication
  • Improve names
  • Tests stay green
}

' Relationships
TDDTest ..> TDD : tests >
TDD ..> Deal : uses >
TDDTest ..> Deal : uses >
TDDTest ..> CommissionPlan : uses >
Deal --> DealStatus : has status
CommissionPlan --> PlanStatus : has status

' TDD Cycle Flow
RED -right-> GREEN : test fails
GREEN -right-> REFACTOR : test passes
REFACTOR -down-> RED : next feature

