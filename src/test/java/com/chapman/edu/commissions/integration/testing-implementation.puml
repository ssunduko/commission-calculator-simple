' ==================== MOCKSERVER TESTS ====================
package "MockServer Tests\n(HTTP Endpoint Mocking - 10 tests)" <<Rectangle>> #e1f5fe {

    class DealControllerMockServerTest <<MockServer Test>> {
        -mockServerClient: MockServerClient
        -mockServer: ClientAndServer
