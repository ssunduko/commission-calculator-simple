' Title
title Testing Implementation - Layered MVC Architecture\nUnit, Mock, Integration, API, MockServer, and External Server Testing\n187 Tests Across 17 Test Classes

' ==================== PRODUCTION CODE ====================
package "Production Code\n(System Under Test)" <<Rectangle>> #e3f2fd {

    class Deal <<Model>> {
        -id: String
        -title: String
        -status: DealStatus
        -products: List<DealProduct>
        +calculateTotalValue(): BigDecimal
        +equals(Object): boolean
        +hashCode(): int
    }

    class DealProduct <<Model>> {
        -productId: String
        -productName: String
        -quantity: int
        -price: BigDecimal
        +calculateTotalPrice(): BigDecimal
    }

    class User <<Model>> {
        -id: String
        -email: String
        -roles: Set<UserRole>
        -active: boolean
    }

    class DealController <<Servlet>> {
        -dealService: DealService
        +doGet(request, response): void
        +doPost(request, response): void
        +doPut(request, response): void
        +doDelete(request, response): void
    }

    class AuthenticationFilter <<Filter>> {
        -userService: UserService
        +doFilter(req, res, chain): void
        -isPublicEndpoint(path): boolean
    }

    class DealService <<Service>> {
        -dealRepository: Repository<Deal>
        +getAllDeals(): List<Deal>
        +createDeal(deal): Deal
        +updateDeal(id, deal): Deal
        +deleteDeal(id): boolean
        +closeDealAsWon(id): Deal
        -validateDeal(deal): void
    }

    interface Repository<T> <<Interface>> {
        +findAll(): List<T>
        +findById(id): Optional<T>
        +save(entity): T
        +deleteById(id): boolean
    }

    class H2DealRepository <<Repository>> {
        -dbManager: DatabaseManager
        +findAll(): List<Deal>
        +findById(id): Optional<Deal>
        +save(deal): Deal
        +deleteById(id): boolean
        -mapResultSetToDeal(rs): Deal
    }

    class DatabaseManager <<Singleton>> {
        -connection: Connection
        +getInstance(): DatabaseManager
        +getConnection(): Connection
        +resetDatabase(): void
    }
}

