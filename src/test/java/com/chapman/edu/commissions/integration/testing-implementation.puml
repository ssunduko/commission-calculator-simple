' ==================== TEST FRAMEWORKS ====================
package "Test Frameworks\n(Testing Tools)" <<Rectangle>> #eceff1 {

    class JUnit5 <<Framework>> {
        +@Test
        +@BeforeAll
        +@BeforeEach
        +@AfterAll
        +@DisplayName
        +@Order
        +Assertions
    }

    class Mockito <<Framework>> {
        +@Mock
        +@ExtendWith
        +when()
        +verify()
        +doThrow()
        +ArgumentCaptor
    }

    class RestAssured <<Framework>> {
        +given()
        +when()
        +then()
        +auth()
        +get(), post(), put(), delete()
        +baseURI
    }

    class MockServer <<Framework>> {
        +MockServerClient
        +ClientAndServer
        +request()
        +response()
        +when().respond()
    }

    class Hamcrest <<Matchers>> {
        +equalTo()
        +notNullValue()
        +hasSize()
        +containsString()
    }
}

