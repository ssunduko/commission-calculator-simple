' Title
title Rate Limiting Test Architecture - Commission Calculator

' Test Classes
class TokenBucketRateLimiterTest <<TestClass>> {
  -rateLimiter: RateLimiter
  -config: RateLimitConfig
  +{nested} BasicRateLimiting
  +{nested} TokenRefillMechanism
  +{nested} ConcurrentAccess
  +{nested} ConfigurationVariations
  +{nested} ResetFunctionality
  +{nested} EdgeCases
}

class SlidingWindowRateLimiterTest <<TestClass>> {
  -rateLimiter: RateLimiter
  -config: RateLimitConfig
  +{nested} SlidingWindowBehavior
  +{nested} AccuracyTests
  +{nested} ConcurrentAccess
  +{nested} ResetFunctionality
  +{nested} TimeUntilNextPermit
}

class RateLimitFilterTest <<TestClass>> {
  -filter: RateLimitFilter
  -rateLimiter: RateLimiter
  -config: RateLimitConfig
  -request: HttpServletRequest
  -response: HttpServletResponse
  -filterChain: FilterChain
  +{nested} IpBasedRateLimiting
  +{nested} UserBasedRateLimiting
  +{nested} ApiKeyBasedRateLimiting
  +{nested} ErrorResponseFormat
  +{nested} HeaderTracking
  +{nested} NonHttpRequests
}

' Nested Test Classes - TokenBucket
class BasicRateLimiting <<NestedTest>> {
  +shouldAllowRequestsWithinLimit()
  +shouldDenyRequestsExceedingLimit()
  +shouldTrackPermitsCorrectly()
  +shouldIsolateDifferentKeys()
}

class TokenRefillMechanism <<NestedTest>> {
  +shouldRefillTokensOverTime()
  +shouldNotExceedBucketCapacity()
}

class ConcurrentAccessTokenBucket <<NestedTest>> {
  +shouldHandleConcurrentRequestsSafely()
  +shouldHandleDifferentKeysConcurrently()
}

class ConfigurationVariations <<NestedTest>> {
  +shouldRespectDifferentRateLimits(long)
  +shouldWorkWithPredefinedConfigs()
}

class ResetFunctionalityTokenBucket <<NestedTest>> {
  +shouldResetSingleKey()
  +shouldResetAllKeys()
  +shouldNotAffectOtherKeysWhenResettingOne()
}

class EdgeCases <<NestedTest>> {
  +shouldHandleNullKeyGracefully()
  +shouldHandleEmptyKey()
  +shouldCalculateTimeUntilNextPermit()
}

' Nested Test Classes - SlidingWindow
class SlidingWindowBehavior <<NestedTest>> {
  +shouldAllowRequestsWithinLimit()
  +shouldDenyRequestsExceedingLimit()
  +shouldAllowRequestsAfterWindowSlides()
  +shouldGraduallyAllowRequestsAsWindowSlides()
}

class AccuracyTests <<NestedTest>> {
  +shouldPreventBoundaryExploitation()
  +shouldTrackAvailablePermitsAccurately()
}

class ConcurrentAccessSlidingWindow <<NestedTest>> {
  +shouldHandleConcurrentRequestsSafely()
}

class ResetFunctionalitySlidingWindow <<NestedTest>> {
  +shouldResetSingleKey()
  +shouldResetAllKeys()
}

class TimeUntilNextPermit <<NestedTest>> {
  +shouldReturnZeroWhenPermitsAvailable()
  +shouldCalculateTimeUntilNextPermit()
}

' Nested Test Classes - Filter
class IpBasedRateLimiting <<NestedTest>> {
  +shouldAllowRequestsWithinLimit()
  +shouldDenyRequestsExceedingLimit()
  +shouldUseXForwardedForHeaderWhenPresent()
  +shouldSetRateLimitHeaders()
}

class UserBasedRateLimiting <<NestedTest>> {
  +shouldUseUserIdWhenAvailable()
  +shouldFallBackToIpWhenNoUserId()
}

class ApiKeyBasedRateLimiting <<NestedTest>> {
  +shouldUseApiKeyWhenPresent()
  +shouldFallBackToIpWhenNoApiKey()
}

class ErrorResponseFormat <<NestedTest>> {
  +shouldReturnJsonErrorResponse()
}

class HeaderTracking <<NestedTest>> {
  +shouldUpdateRemainingCountAfterEachRequest()
}

class NonHttpRequests <<NestedTest>> {
  +shouldPassThroughNonHttpRequests()
}

' Production Classes Being Tested
class TokenBucketRateLimiter <<ProductionClass>> {
}

class SlidingWindowRateLimiter <<ProductionClass>> {
}

class RateLimitFilter <<ProductionClass>> {
}

class RateLimitConfig <<ProductionClass>> {
}

interface RateLimiter <<Interface>> {
}

' Test Utilities
class Mockito <<TestingFramework>> {
  +mock(Class): T
  +when(T): OngoingStubbing
  +verify(T): T
  +never(): VerificationMode
  +times(int): VerificationMode
  +any(): T
  +eq(T): T
}

class JUnit5 <<TestingFramework>> {
  +@Test
  +@Nested
  +@BeforeEach
  +@DisplayName
  +@ParameterizedTest
  +@ValueSource
  +assertEquals()
  +assertTrue()
  +assertFalse()
  +assertDoesNotThrow()
}

class ExecutorService <<Concurrency>> {
  +newFixedThreadPool(int): ExecutorService
  +submit(Runnable): Future
  +shutdown(): void
}

class CountDownLatch <<Concurrency>> {
  +CountDownLatch(int)
  +countDown(): void
  +await(long, TimeUnit): boolean
}

