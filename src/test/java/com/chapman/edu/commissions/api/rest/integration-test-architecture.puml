' Test Base Class
abstract class ApiIntegrationTestBase <<TestFixture>> {
  #server: ApiServer
  #httpClient: HttpClient
  #TEST_PORT: int
  #BASE_URL: String
  +startServer(): void {static}
  +stopServer(): void {static}
  #get(path: String): HttpResponse<String>
  #post(path: String, jsonBody: String): HttpResponse<String>
  #put(path: String, jsonBody: String): HttpResponse<String>
  #delete(path: String): HttpResponse<String>
  #parseResponse(response: HttpResponse, clazz: Class): T
  #assertStatus(response: HttpResponse, expectedStatus: int): void
  #getBaseUrl(): String
}

