  +clearAllData(): void
}

' HTTP Client
class HttpClient <<JavaStandardLibrary>> {
  +send(request: HttpRequest, handler: BodyHandler): HttpResponse
  +newBuilder(): HttpClient.Builder
}

class HttpRequest <<JavaStandardLibrary>> {
  +newBuilder(): HttpRequest.Builder
  +uri(uri: URI): Builder
  +GET(): Builder
  +POST(bodyPublisher: BodyPublisher): Builder
  +PUT(bodyPublisher: BodyPublisher): Builder
  +DELETE(): Builder
  +header(name: String, value: String): Builder
  +build(): HttpRequest
}

class HttpResponse <<JavaStandardLibrary>> {
  +statusCode(): int
  +body(): T
  +headers(): HttpHeaders
}

