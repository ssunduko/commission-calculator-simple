' Mockito Core Classes
class Mockito <<Framework>> {
  +spy(realObject: T): T
  +mock(classToMock: Class<T>): T
  +when(methodCall: T): OngoingStubbing<T>
  +doReturn(toBeReturned: Object): Stubber
  +doNothing(): Stubber
  +doThrow(toBeThrown: Throwable): Stubber
  +verify(mock: T): T
  +reset(mocks: Object...): void
}

class MockitoAnnotations <<Framework>> {
  +openMocks(testClass: Object): AutoCloseable
}

' Spy-specific concepts
class SpyWrapper <<Concept>> {
  -realObject: Object
  -stubbings: Map<Method, Object>
  +callRealMethod(): Object
  +callStubbedMethod(): Object
  +isStubbed(method: Method): boolean
}

interface Stubber <<Framework>> {
  +when(mock: T): T
  +doReturn(toBeReturned: Object): Stubber
  +doThrow(toBeThrown: Throwable): Stubber
  +doNothing(): Stubber
  +doAnswer(answer: Answer): Stubber
}

' Test class
class MockitoSpyTest <<TestClass>> {
  -spyUser: User
  +testCreatingSpies(): void
  +testRealMethodCalls(): void
  +testStateSharing(): void
  +testSelectiveStubbing(): void
  +testDoReturnVsWhen(): void
  +testVerification(): void
  +testSpyVsMock(): void
  +testPartialMocking(): void
  +testSpyOnCollections(): void
  +testLimitations(): void
  +testRealWorldScenario(): void
}

' Mock vs Spy comparison
class MockObject <<Concept>> {
  -noImplementation: true
  -defaultBehavior: "returns null/0/false"
  +anyMethod(): null
}

class SpyObject <<Concept>> {
  -wrapsRealObject: true
  -defaultBehavior: "calls real method"
  +anyMethod(): realResult
}

