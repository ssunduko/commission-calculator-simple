' Real Domain Objects (that get spied on)
class Deal <<RealObject>> {
  -id: String
  -title: String
  -value: BigDecimal
  -status: DealStatus
  -salesRepId: String
  -products: List<DealProduct>
  +getTitle(): String
  +getValue(): BigDecimal
  +setStatus(status: DealStatus): void
  +calculateTotalValue(): BigDecimal
  +addProduct(product: DealProduct): void
}

class User <<RealObject>> {
  -id: String
  -username: String
  -email: String
  -firstName: String
  -lastName: String
  -active: boolean
  -roles: Set<UserRole>
  +getFullName(): String
  +hasRole(role: UserRole): boolean
  +isActive(): boolean
  +setActive(active: boolean): void
